---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/site/PageHead.astro';
import HowIWork from '../components/site/HowIWork.astro';
import { pages } from '../data/site.ts';

const route = pages.find((page) => page.href === '/method/')!;
---

<BaseLayout title={route.title} description={route.description} canonicalUrl={`https://echowaves.com${route.href}`}>
  <PageHead route={route} />
  <HowIWork />
</BaseLayout>
