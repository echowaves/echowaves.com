---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrivacyComponent from '../components/Privacy';
import { utilityPages } from '../data/site.ts';

const route = utilityPages.privacy;
---

<BaseLayout
  title={route.title}
  description={route.description}
  canonicalUrl={`https://echowaves.com${route.href}`}
>
  <PrivacyComponent />
</BaseLayout>
