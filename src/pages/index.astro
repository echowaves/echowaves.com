---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/site/Hero.astro';
import Work from '../components/site/Work.astro';
import { identity, pages } from '../data/site.ts';

const route = pages.find((page) => page.href === '/')!;

// Person schema without job titles or employers.
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.name,
  url: 'https://echowaves.com',
  email: `mailto:${identity.email}`,
  knowsAbout: [
    'Agentic software engineering',
    'Engineering leadership',
    'Delivery measurement',
    'Release management',
    'React Native and Expo',
  ],
  sameAs: identity.links.map((link) => link.href),
};
---

<BaseLayout title={route.title} description={route.description} canonicalUrl="https://echowaves.com/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </Fragment>

  <Hero />
  <Work />
</BaseLayout>
