---
import BaseLayout from '../layouts/BaseLayout.astro';
import SheetChrome from '../components/regions/SheetChrome.astro';
import TitleBlock from '../components/regions/TitleBlock.astro';
import CareerSchematic from '../components/regions/CareerSchematic.astro';
import AiPractice from '../components/regions/AiPractice.astro';
import OperatorProfile from '../components/regions/OperatorProfile.astro';
import OpenSource from '../components/regions/OpenSource.astro';
import Writing from '../components/regions/Writing.astro';
import Contact from '../components/regions/Contact.astro';
import { getBlogData, type DevToSnapshot } from '../utils/devto';
import {
  pageTitle,
  pageDescription,
  identity,
  destinations,
  packages,
} from '../content/claims';

// Region order is fixed by EXPERIENCE.md IA (AD-4); reordering requires a spine edit.
let snapshot: DevToSnapshot | null = null;
try {
  snapshot = await getBlogData();
} catch (e) {
  console.warn('dev.to snapshot unavailable at build time:', e);
}

const jsonLdPerson = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.name,
  jobTitle: 'Engineering Executive — AI-Native Transformation',
  url: 'https://echowaves.com',
  sameAs: [
    destinations.githubProfile,
    destinations.linkedin,
    destinations.devto,
  ],
};

const jsonLdPackages = packages.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: p.name,
  description: p.description,
  codeRepository: p.repo,
  programmingLanguage: 'TypeScript',
  runtimePlatform: 'React Native',
}));
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl="https://echowaves.com/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPackages)} />
  </Fragment>

  <SheetChrome slot="header" />

  <main slot="main">
    <TitleBlock />
    <CareerSchematic />
    <AiPractice />
    <OperatorProfile />
    <OpenSource />
    <Writing snapshot={snapshot} />
    <Contact />
  </main>

  <SheetChrome slot="footer" />
</BaseLayout>
