---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, wisawStory } from '../../data/site.ts';

const wisaw = products.find((product) => product.id === 'wisaw');
const installLinks = (wisaw?.links ?? []).filter((link) => link.href !== '/wisaw');
---

<BaseLayout
  title={wisawStory.title}
  description={wisawStory.pageDescription}
  canonicalUrl="https://echowaves.com/builds/wisaw"
>
  <section class="story">
      <h1>{wisawStory.title}</h1>
      <p class="lede">{wisawStory.lede}</p>

      <p class="install">
        {wisawStory.installNote}
        {
          installLinks.map((link) => (
            <a href={link.href} rel="noopener noreferrer" target="_blank">
              {link.label}
            </a>
          ))
        }
      </p>

      <h2>{wisawStory.originHeading}</h2>
      {wisawStory.originBody.map((paragraph) => <p set:html={paragraph} />)}

      <h2>The architecture, in the order it happened</h2>
      <ol class="phases">
        {
          wisawStory.phases.map((phase) => (
            <li>
              <p class="when">{phase.when}</p>
              <div>
                <h3>{phase.title}</h3>
                <p set:html={phase.body} />
              </div>
            </li>
          ))
        }
      </ol>

      <h2>{wisawStory.bugHeading}</h2>
      {wisawStory.bugBody.map((paragraph) => <p set:html={paragraph} />)}

      <h2>{wisawStory.aiHeading}</h2>
      <p class="lede">{wisawStory.aiLede}</p>
      {
        wisawStory.aiPoints.map((point) => (
          <div class="point">
            <h3>{point.title}</h3>
            <p set:html={point.body} />
          </div>
        ))
      }

      <p class="back">
        <a href="/builds/">All builds</a>
        <a href="/">Home</a>
      </p>
    </section>
</BaseLayout>

<style>
  .story {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-9) var(--space-5);
  }

  h1 {
    font-size: var(--text-display);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-5);
  }

  h2 {
    font-size: var(--text-heading);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  h3 {
    font-size: var(--text-lede);
    font-weight: 600;
  }

  p {
    max-width: 68ch;
  }

  p + p {
    margin-top: var(--space-4);
  }

  .lede {
    font-size: var(--text-lede);
    color: var(--text-dim);
  }

  .install {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    font-size: var(--text-body);
    color: var(--text-dim);
  }

  .phases {
    list-style: none;
    margin-top: var(--space-2);
  }

  .phases > li {
    display: grid;
    gap: var(--space-1) var(--space-5);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border);
  }

  .when {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--accent);
    padding-top: var(--space-1);
    margin-top: 0;
  }

  .point {
    margin-top: var(--space-6);
  }

  .point p {
    margin-top: var(--space-1);
  }

  .back {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    display: flex;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .phases > li {
      grid-template-columns: 110px minmax(0, 1fr);
    }
  }
</style>
