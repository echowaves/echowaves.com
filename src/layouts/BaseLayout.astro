---
import '../index.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { hero } from '../data/site.ts';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalUrl = 'https://echowaves.com',
  ogImage = 'https://echowaves.com/og.png',
} = Astro.props;

// The card is generated from the hero copy by `npm run og`; it is 1200×630 so Facebook and
// LinkedIn reserve the large image without cropping, and its alt text is the same sentence
// the page itself opens with.
const ogAlt = `${hero.name}${hero.synopsis} \u2014 ${hero.headline}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-22JW6D5KRZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-22JW6D5KRZ');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060606" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <!--
      Icons, every one of them cut from scripts/echowaves-logo.jpeg by `npm run icons`:
      transparent artwork on purpose, so the mark sits on a light tab strip and a dark one
      alike. What sat here before was Create React App's atom logo at six sizes and a
      manifest that still called this site "Create React App Sample".
    -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- JSON-LD Organization (every page) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Echowaves",
      "url": "https://echowaves.com",
      "logo": "https://echowaves.com/icon-512.png",
      "sameAs": [
        "https://github.com/echowaves",
        "https://www.linkedin.com/in/dmitryame",
        "https://dev.to/dmitryame"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "dmitry@echowaves.com",
        "contactType": "technical support"
      }
    })} />

    <slot name="head" />
  </head>
  <body>
    <!--
     One window on a grey desk: the chrome, the tab strip and the footer belong to
     every route, so they live here rather than being repeated by each page.
    -->
    <div class="window">
      <a class="skip-link" href="#main">Skip to content</a>
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
