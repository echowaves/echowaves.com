---
import '../index.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { hero } from '../data/site.ts';
import { defaultTheme, themeScriptPayload } from '../data/themes.ts';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalUrl = 'https://echowaves.com',
  ogImage = 'https://echowaves.com/og.png',
} = Astro.props;

// The card is generated from the hero copy by `npm run og`; it is 1200×630 so Facebook and
// LinkedIn reserve the large image without cropping, and its alt text is the same sentence
// the page itself opens with.
const ogAlt = `${hero.name}${hero.synopsis} \u2014 ${hero.headline}`;

/*
 * With no script there is one palette per scheme (the media-query fallback in src/index.css).
 * With a script there are eight, and the reader chooses. The runtime below is inline because it
 * has to run before the first paint — a stylesheet or a deferred script would show the wrong
 * palette for a frame — and because the site ships no JS bundle. It reads the stored preference,
 * paints `<html data-theme>`, repaints the tab colour and the favicons from the same palette,
 * follows the OS while the mode is `system`, re-reads the store when another tab writes it, and
 * wires the titlebar control. A corrupt or unknown stored value — including a stored `custom`
 * mode from before 2026-10-27, which resolves as `system` with its pins — resolves to something
 * honest; nothing here throws.
 */
const themeDefaultDark = defaultTheme('dark');
const themeDefaultLight = defaultTheme('light');
const themeScript = `(${function () {
  var P = __PAYLOAD__;
  var byId = {};
  for (var i = 0; i < P.themes.length; i++) byId[P.themes[i].id] = P.themes[i];

  function stored() {
    try {
      var value = JSON.parse(localStorage.getItem(P.storageKey) || '{}');
      return value && typeof value === 'object' ? value : {};
    } catch (error) {
      return {};
    }
  }

  // Tampered or half-written data is ignored rather than trusted: an unknown id or mode falls
  // back to the group default and to `system`, and the next deliberate change overwrites it.
  function pinned(id, group) {
    return byId[id] && byId[id].group === group ? id : P.defaults[group];
  }

  // One read of the store, shared by first paint and by a `storage` event from another tab: the
  // second one is the same resolution, not a special case. `sync` belongs to the control further
  // down, which does not exist yet while this runs.
  var mode = 'system';
  var light = P.defaults.light;
  var dark = P.defaults.dark;
  var sync = null;

  function read() {
    var preference = stored();
    // A retired mode is an unknown mode: `custom` left the registry on 2026-10-27, so a stored
    // custom pair lands on `system` here — which is exactly what custom did, follow the OS with
    // these pins. The next deliberate save rewrites the mode as light, dark or system.
    mode = P.modes.indexOf(preference.mode) > -1 ? preference.mode : 'system';
    light = pinned(preference.light, 'light');
    dark = pinned(preference.dark, 'dark');
  }

  var query = window.matchMedia ? window.matchMedia('(prefers-color-scheme: light)') : null;

  function resolvedId() {
    if (mode === 'light') return light;
    if (mode === 'dark') return dark;
    // `system` follows the OS between the stored pair — the pins are what "custom" used to be.
    return query && query.matches ? light : dark;
  }

  function apply() {
    var theme = byId[resolvedId()] || byId[P.defaults.dark];
    document.documentElement.setAttribute('data-theme', theme.id);
    // Two theme-color tags ship: an unqualified one and a `(prefers-color-scheme: light)` one, so
    // the tab colour matches the page with scripts off. Once a palette is chosen it outranks the
    // OS scheme, so both are given the chosen ground and the browser cannot pick the stale one.
    var metas = document.querySelectorAll('meta[name="theme-color"]');
    for (var m = 0; m < metas.length; m++) metas[m].setAttribute('content', theme.bg);
    // Only the PNG favicons, which exist per theme. The .ico container, the apple-touch tile and
    // the manifest icons stay as `npm run icons` cut them: transparent artwork on any tab strip.
    // The payload carries one href template per size, rendered by the registry's own `faviconHref`,
    // so the script cannot invent a filename the writer never made — a swap to a path nobody
    // generated is a default globe in the tab, which is nothing for anyone to notice.
    var links = document.querySelectorAll('link[rel~="icon"]');
    for (var j = 0; j < links.length; j++) {
      var size = (links[j].getAttribute('sizes') || '').split('x')[0];
      var template = /^[0-9]+$/.test(size) ? P.faviconTemplates[size] : null;
      if (template) links[j].setAttribute('href', template.split('{id}').join(theme.id));
    }
  }

  read();
  apply();

  if (window.addEventListener) {
    window.addEventListener('storage', function (event) {
      // Only other documents fire this, so it cannot loop against our own save().
      if (event && event.key && event.key !== P.storageKey) return;
      read();
      apply();
      if (sync) sync();
    });
  }

  if (query) {
    var follow = function () {
      if (mode === 'system') apply();
    };
    if (query.addEventListener) query.addEventListener('change', follow);
    else if (query.addListener) query.addListener(follow);
  }

  // The control lives in the title bar, which does not exist yet while this runs.
  function whenReady(handler) {
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', handler);
    else handler();
  }

  whenReady(function () {
    var select = document.getElementById('theme-mode');
    if (!select) return;
    // The set-default groups arrive disabled in the markup — without a script they would be dead
    // options — and this is the moment a script exists: wiring up is what earns them a click.
    var groups = [document.getElementById('theme-set-light'), document.getElementById('theme-set-dark')];
    for (var g = 0; g < groups.length; g++) {
      if (groups[g]) groups[g].disabled = false;
    }
    var modeOptions = {
      light: document.getElementById('theme-mode-light'),
      dark: document.getElementById('theme-mode-dark'),
    };

    sync = function () {
      // The displayed value always states what the page is painting: one of the three modes,
      // never a palette id left over from a set-default pick.
      select.value = mode;
      // And the two dynamic labels name the palettes that means, from the same registry the
      // markup rendered — after a pin or another tab's write, "Light — Solarized Light" follows.
      if (modeOptions.light) modeOptions.light.textContent = P.modeLabels.light + ' — ' + byId[light].label;
      if (modeOptions.dark) modeOptions.dark.textContent = P.modeLabels.dark + ' — ' + byId[dark].label;
    };

    function save() {
      try {
        localStorage.setItem(P.storageKey, JSON.stringify({ mode: mode, light: light, dark: dark }));
      } catch (error) {
        /* Private mode or a full quota: the choice still applies to this page. */
      }
    }

    // One handler for one control. Order of resolution is load-bearing: a value that names a
    // mode is a mode first — a palette id colliding with a mode name must not shadow it — and a
    // palette lookup answers only for its own keys, so inherited Object.prototype entries
    // ('constructor' and friends) cannot masquerade as a theme. Unknown values (nobody typed
    // them into a native select, but nothing about the DOM is trustworthy) settle on `system`.
    select.addEventListener('change', function () {
      var value = select.value;
      if (P.modes.indexOf(value) > -1) {
        mode = value;
      } else if (
        Object.prototype.hasOwnProperty.call(byId, value) &&
        P.modes.indexOf(byId[value].group) > -1
      ) {
        // A set-default pick applies immediately: the palette is pinned to its group and the
        // mode flips to that group, so the choice visibly works rather than waiting for an OS.
        var theme = byId[value];
        if (theme.group === 'light') light = theme.id;
        else dark = theme.id;
        mode = theme.group;
      } else {
        mode = 'system';
      }
      save();
      apply();
      sync();
    });

    sync();
  });
}})()`.replace('__PAYLOAD__', () => JSON.stringify(themeScriptPayload()));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      The tab colour and the icons come before the theme runtime, in this order, because the
      runtime paints them. Two theme-color tags: `media` picks one per OS scheme, which is what a
      reader with scripts off gets (the media-query palette in src/index.css has the same two
      grounds), and the runtime overwrites both with whatever palette it actually resolved. Each
      palette has its own favicon; the transparent pair here reads on a light tab strip and a dark
      one alike. Every icon here was cut from scripts/echowaves-logo.jpeg by `npm run icons`; what
      sat here before was Create React App's atom logo at six sizes and a manifest that still called
      this site "Create React App Sample".
    -->
    <meta name="theme-color" content={themeDefaultDark.tokens.background} />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content={themeDefaultLight.tokens.background}
    />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <script is:inline set:html={themeScript} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-22JW6D5KRZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-22JW6D5KRZ');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <!-- JSON-LD Organization (every page) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Echowaves",
      "url": "https://echowaves.com",
      "logo": "https://echowaves.com/icon-512.png",
      "sameAs": [
        "https://github.com/echowaves",
        "https://www.linkedin.com/in/dmitryame",
        "https://dev.to/dmitryame"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "dmitry@echowaves.com",
        "contactType": "technical support"
      }
    })} />

    <slot name="head" />
  </head>
  <body>
    <!--
     One window on a grey desk: the chrome, the tab strip and the footer belong to
     every route, so they live here rather than being repeated by each page.
    -->
    <div class="window">
      <a class="skip-link" href="#main">Skip to content</a>
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
