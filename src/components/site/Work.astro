---
import { work } from '../../data/site.ts';
---

<section id="work">
  <h2>{work.heading}</h2>
  <p class="lead">{work.lead}</p>
  <ul>
    {work.points.map((point) => <li>{point}</li>)}
  </ul>
</section>

<style>
  h2 {
    font-size: 1.5rem;
    margin-bottom: 12px;
  }

  .lead {
    font-size: 1.1875rem;
    max-width: 62ch;
  }

  ul {
    margin-top: 24px;
    list-style: none;
    display: grid;
    gap: 14px;
  }

  li {
    color: var(--text-dim);
    max-width: 68ch;
    padding-left: 20px;
    position: relative;
  }

  li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--border);
  }
</style>
