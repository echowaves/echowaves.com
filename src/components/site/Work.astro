---
import { work } from '../../data/site.ts';
---

<section id="work">
  <h2>{work.heading}</h2>
  <p class="lead">{work.lead}</p>
  <ul>
    {work.points.map((point) => <li>{point}</li>)}
  </ul>
</section>

<style>
  h2 {
    font-size: var(--text-heading);
    margin-bottom: var(--space-3);
  }

  .lead {
    font-size: var(--text-lede);
    max-width: 62ch;
  }

  ul {
    margin-top: var(--space-6);
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  li {
    color: var(--text-dim);
    max-width: 68ch;
    padding-left: var(--space-5);
    position: relative;
  }

  li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--border);
  }
</style>
