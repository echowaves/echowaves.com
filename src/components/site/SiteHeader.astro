---
import ThemeControl from './ThemeControl.astro';
import { nav, shellPrompt } from '../../data/site.ts';

/*
 * The window chrome: title bar plus one tab per route. Tabs are plain links, so
 * navigation needs no JavaScript and every view stays deep-linkable. They are not
 * ARIA tabs and must not claim the tablist role.
 */
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/') return path === '/';
  return path === target || path.startsWith(`${target}/`);
};
const shellPath = path === '/' ? '~/echowaves' : `~/echowaves${path}`;
---

<header class="chrome">
  <div class="titlebar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <a class="mark" href="/" aria-label="Echowaves home">
      <span class="mark-glyph" aria-hidden="true"></span>
    </a>
    <p class="path">
      <span class="host">{shellPrompt}</span><span class="sep"> &mdash; </span>{shellPath}
    </p>
    <ThemeControl />
  </div>

  <nav class="tabs" aria-label="Primary">
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-current={current(item.href) ? 'page' : undefined}
          class:list={{ tab: true, active: current(item.href) }}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .chrome {
    position: sticky;
    top: 0;
    z-index: 5;
    background-color: var(--panel);
    border-bottom: 1px solid var(--border);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .lights {
    display: inline-flex;
    gap: var(--space-2);
    flex: none;
  }

  /* Paint, not controls: never focusable, never clickable, hidden from AT. */
  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 9999px;
    display: block;
  }

  .lights i:nth-child(1) {
    background-color: var(--danger);
  }

  .lights i:nth-child(2) {
    background-color: var(--emphasis);
  }

  .lights i:nth-child(3) {
    background-color: var(--accent);
  }

  /*
   * The mark, cut out of scripts/echowaves-logo.jpeg by `npm run icons`. It links to the route
   * the first tab already points at, so the anchor carries the name and the artwork is hidden
   * from assistive tech — one label, not two. Underline is off because an underline across a logo
   * reads as a rendering accident, and this link is identified by its position and its accessible
   * name rather than by paint.
   *
   * The artwork is used as a mask rather than as an image, which is what lets the mark follow the
   * active palette: `--accent` paints it, so no per-theme logo raster is needed and a theme swap
   * repaints it in the same frame as everything else. The source keeps its own alpha, so the
   * strokes stay anti-aliased.
   */
  .mark {
    display: inline-flex;
    flex: none;
    text-decoration: none;
  }

  .mark-glyph {
    display: block;
    /* /logo.png is 57×64 trimmed; `contain` keeps that ratio inside the box. */
    width: var(--space-6);
    height: var(--space-5);
    background-color: var(--accent);
    -webkit-mask-image: url('/logo.png');
    mask-image: url('/logo.png');
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  .path {
    font-size: var(--text-fine);
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .host {
    color: var(--accent);
  }

  .sep {
    color: var(--decoration-green);
  }

  /*
   * Seven tabs never fit 375px, so the strip wraps onto more rows instead of
   * scrolling out of sight or hiding routes behind a disclosure. A scroll container
   * gave no affordance that it scrolled: the last tab looked like no tab existed.
   * Wrapping keeps every route visible at once and still needs no script; the chrome
   * grows taller on narrow screens, which is what `--chrome-offset` accounts for.
   */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-1);
    background-color: var(--panel);
    padding: 0 var(--space-1);
  }

  .tab {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-meta);
    color: var(--text-dim);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    min-height: 44px;
    line-height: 24px;
  }

  .tab:hover {
    color: var(--text);
  }

  /* aria-current carries the state for assistive tech; the underline is the paint. */
  .tab.active {
    color: var(--text);
    background-color: var(--background);
    border-bottom-color: var(--accent);
  }
</style>
