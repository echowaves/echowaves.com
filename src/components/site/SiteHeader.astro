---
import { identity, nav } from '../../data/site.ts';

// identity.wordmark is stored whole ('~/echowaves'); only the prefix is coloured.
const wordmarkPrefix = identity.wordmark.slice(0, 2);
---

<header class="site-header">
  <div class="bar">
    <a class="mark" href="/#top">
      <span class="mark-prefix">{wordmarkPrefix}</span>{identity.wordmark.slice(wordmarkPrefix.length)}
    </a>

    <nav class="inline" aria-label="Sections">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <details class="compact">
      <summary>Menu</summary>
      <nav aria-label="Sections, collapsed">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background-color: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
  }

  .bar {
    max-width: 720px;
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .mark {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .mark:hover {
    color: var(--accent-blue);
  }

  .mark-prefix {
    color: var(--accent-green);
  }

  .inline {
    display: none;
    gap: 18px;
    font-size: 0.9375rem;
  }

  .inline a {
    color: var(--text-secondary);
  }

  .inline a:hover {
    color: var(--accent-blue);
  }

  .compact {
    position: relative;
    font-size: 0.9375rem;
  }

  .compact summary {
    cursor: pointer;
    color: var(--text-secondary);
    list-style: none;
  }

  .compact summary::-webkit-details-marker {
    display: none;
  }

  .compact[open] nav {
    position: absolute;
    right: 0;
    top: 1.7em;
    display: grid;
    gap: 10px;
    padding: 14px 18px;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    min-width: 160px;
  }

  @media (min-width: 720px) {
    .inline {
      display: flex;
    }

    .compact {
      display: none;
    }
  }
</style>
