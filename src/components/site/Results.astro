---
import { claims, scaleNote } from '../../data/site.ts';
---

<section id="results">
  <h2>Results</h2>

  <ul class="results">
    {
      claims.map((claim) => (
        <li>
          <p class="metric">{claim.metric}</p>
          <div>
            <h3>{claim.label}</h3>
            <p class="detail">{claim.detail}</p>
            <p class="source">{claim.source}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <p class="scale">{scaleNote}</p>
</section>

<style>
  h2 {
    font-size: var(--text-heading);
    margin-bottom: var(--space-2);
  }

  .results {
    list-style: none;
  }

  .results > li {
    display: grid;
    gap: var(--space-1) var(--space-6);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--border);
  }

  .metric {
    font-family: var(--font-mono);
    font-size: var(--text-figure);
    line-height: 1.2;
  }

  h3 {
    font-size: var(--text-lede);
    font-weight: 600;
  }

  .detail {
    color: var(--text-dim);
    margin-top: var(--space-1);
    max-width: 68ch;
  }

  .source {
    margin-top: var(--space-2);
    font-size: var(--text-meta);
    color: var(--text-dim);
  }

  .scale {
    margin-top: var(--space-6);
    color: var(--text-dim);
    max-width: 68ch;
  }

  @media (min-width: 640px) {
    .results > li {
      grid-template-columns: 190px minmax(0, 1fr);
    }
  }
</style>
