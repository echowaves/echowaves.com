---
import { openSource, packages } from '../../data/site.ts';
import {
  FIGURES_NOTE,
  OFFLINE_NOTE,
  formatCount,
  formatReleaseDate,
  statsFor,
  type RegistrySnapshot,
} from '../../utils/registry.ts';

interface Props {
  snapshot: RegistrySnapshot | null;
}

const { snapshot } = Astro.props;
---

<section id="code">
  <h2>{openSource.heading}</h2>
  <p class="lead">{openSource.lead}</p>

  <ul class="packages">
    {
      packages.map((pkg) => {
        const stats = statsFor(snapshot, pkg.name);
        const figures = [
          formatCount(stats?.weeklyDownloads ?? null) &&
            `${formatCount(stats?.weeklyDownloads ?? null)} downloads last week`,
          formatCount(stats?.stars ?? null) && `${formatCount(stats?.stars ?? null)} stars on GitHub`,
          formatReleaseDate(stats?.lastRelease ?? null) &&
            `last release ${formatReleaseDate(stats?.lastRelease ?? null)}`,
        ].filter(Boolean) as string[];

        return (
          <li>
            <div class="head">
              <h3>{pkg.name}</h3>
              <code class="install">npm i {pkg.npmPackage}</code>
            </div>
            <p class="summary">{pkg.summary}</p>
            <p class="figures">
              {figures.length > 0 ? figures.join(' · ') : 'Figures unavailable for this build'}
            </p>
            <p class="links">
              <a href={stats?.npmUrl ?? `https://www.npmjs.com/package/${pkg.npmPackage}`} rel="noopener noreferrer" target="_blank">
                npm
              </a>
              <a
                href={stats?.repositoryUrl ?? `https://github.com/echowaves/${pkg.repo}`}
                rel="noopener noreferrer"
                target="_blank"
              >
                GitHub
              </a>
            </p>
          </li>
        );
      })
    }
  </ul>

  <p class="note">{snapshot === null || snapshot.offline || !snapshot.hasFigures ? OFFLINE_NOTE : FIGURES_NOTE}</p>
</section>

<style>
  h2 {
    font-size: var(--text-heading);
    margin-bottom: var(--space-3);
  }

  .lead {
    color: var(--text-dim);
    max-width: 64ch;
    margin-bottom: var(--space-2);
  }

  .packages {
    list-style: none;
  }

  .packages > li {
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }

  h3 {
    font-family: var(--font-mono);
    font-size: var(--text-lede);
  }

  .install {
    font-size: var(--text-meta);
    color: var(--text-dim);
  }

  .summary {
    margin-top: var(--space-1);
    max-width: 64ch;
  }

  .figures {
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--text-dim);
  }

  .links {
    margin-top: var(--space-2);
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-body);
  }

  .note {
    margin-top: var(--space-5);
    font-size: var(--text-meta);
    color: var(--text-dim);
  }
</style>
