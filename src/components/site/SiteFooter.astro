---
import { asOf, identity } from '../../data/site.ts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <p class="statement">
      Work figures are current as of {asOf}. npm and GitHub counts update when the site is rebuilt. Spotted an error?
      <a href={`mailto:${identity.email}`}>{identity.email}</a>.
    </p>

    <nav class="links" aria-label="Footer">
      <a href="/impact.json">impact.json</a>
      <a href="/support">Support</a>
      <a href="/privacy">Privacy</a>
    </nav>

    <p class="fine">
      {year} — {identity.name}, {identity.location}.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background-color: var(--panel);
    margin-top: var(--space-7);
  }

  .inner {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-5) var(--space-9);
    display: grid;
    gap: var(--space-6);
  }

  .statement {
    max-width: 68ch;
    font-size: var(--text-body);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-fine);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .links a {
    color: var(--text-dim);
  }

  .links a:hover {
    color: var(--accent);
  }

  .fine {
    font-family: var(--font-mono);
    font-size: var(--text-fine);
    color: var(--text-dim);
    border-top: 1px solid var(--border);
    padding-top: var(--space-3);
  }

</style>
