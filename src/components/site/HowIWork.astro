---
import { notes, steps } from '../../data/site.ts';
---

<section id="how">
  <h2>How I work</h2>

  <ol class="steps">
    {
      steps.map((step, index) => (
        <li>
          <span class="num">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="notes">
    {
      notes.map((note) => (
        <div>
          <h4>{note.heading}</h4>
          <p>{note.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  h2 {
    font-size: 1.5rem;
    margin-bottom: 20px;
  }

  .steps {
    list-style: none;
    display: grid;
    gap: 4px;
  }

  .steps > li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 0 16px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-dim);
    padding-top: 3px;
  }

  h3 {
    font-size: 1.0625rem;
  }

  .steps p {
    color: var(--text-dim);
    margin-top: 4px;
    max-width: 64ch;
  }

  .notes {
    margin-top: 40px;
    display: grid;
    gap: 24px;
  }

  h4 {
    font-size: 0.9375rem;
    margin-bottom: 4px;
  }

  .notes p {
    color: var(--text-dim);
    font-size: 0.9375rem;
    max-width: 64ch;
  }

  @media (min-width: 720px) {
    .notes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px 32px;
    }
  }
</style>
